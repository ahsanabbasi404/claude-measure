# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.

# Postgres connection string (Neon: use the pooled URL, it contains "-pooler").
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Shared secret that every developer machine sends as "Authorization: Bearer <token>".
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INGEST_TOKEN=

# Password for the dashboard (single shared login).
DASHBOARD_PASSWORD=

# Random string used to sign the dashboard session cookie. Changing it logs everyone out.
AUTH_SECRET=

# Optional: delete telemetry older than this many days (daily cron). Empty = keep forever.
RETENTION_DAYS=

# Optional: Vercel sets this automatically for cron jobs when defined in project settings.
CRON_SECRET=
